  (:build ()
   (with-directory "ffi/tree-sitter"
    (run-cc "-g" "-O2" "-Wall" 
     "-Wno-ununsed-value" "-ltree-sitter" "-shared" "alien.c" 
     "-o" "../../.stash/libtree-sitter-alien.so")))
  (:install () (with-sudo "cp .stash/libtree-sitter-alien.so /usr/local/lib/")))
 (zstd-alien ()
  (:build () 
   (with-directory "ffi/zstd"
    (run-cc "-g" "-O2" "-Wall" "-Wno-unused-value" "-lzstd" "-shared"
     "alien.c" "-o" "../../.stash/libzstd-alien.so")))
  (:install () 
   (with-sudo "cp .stash/libzstd-alien.so /usr/local/lib/")))
