;;; Code:
:name core
:author ("Richard Westhaver" . "ellis@compiler.company")
:version "0.1.2"
:links 
(:info "https://compiler.company/docs/core/info"
 :man "https://compiler.company/docs/core/man"
 :api "https://compiler.company/docs/core/api")
:license mpl
:stash ".stash"
:description "The Compiler Company Core"
:tags (core lisp emacs)
:vc (:hg "https://vc.compiler.company/core"
     (cb (:git "ssh://git@codeberg.org/c-c/core"))
     (gh (:git "ssh://git@github.com/richardwesthaver/core")))
:bind 
((stash ".stash")
 (cc :env "gcc")
 (packy-home :env "/opt/store/packy")
 (sbcl-src :env (when-let ((src (probe-directory "/usr/src/sbcl"))) (namestring src)))
 (emacs-home :env "/usr/share/emacs/"))
:components
((:org "readme")
 (:sys "core")
 (:module "std" (:sys "std"))
 (:module "alien" (:sys "alien"))
 (:module "lib")
 (:module "skel" (:sys "skel"))
 (:module "etc"
  (:module "lisp")
  (:module "script")
  (:module "emacs")))
:rules
((default (data rebuild-core))
 (bootstrap (data build-core))
 (data (%stash psl.dat kbd.sxp x11.lisp parquet.json))
 (all
  (%stash
   psl.dat x11.lisp kbd.sxp parquet.thrift
   rebuild-core
   deploy))
 (upstream ()
  "Push our local hg repo to remote git mirrors (github and codeberg)"
  (labels ((remotes (name)
            (vector
             (make-vc-remote :type :hg :name "cb" :url (format nil "ssh://git@codeberg.org/c-c/~A" name))
             (make-vc-remote :type :hg :name "gh" :url (format nil "ssh://git@github.com/richardwesthaver/~A" name)))))
   (vc-export (vc *project*) :filter-regexp "^std$" :upstream nil) ;; yuck
   (with-repo (r :path "/tmp/core" :type :git :delete t)
    (loop for remote across (setf (vc-remotes r) (remotes "core"))
     do (vc-remote r :add :name (name remote) :url (uri remote)))
    (vc-push r :set-upstream t :remote "gh" :force t :branch "default")
    (vc-push r :remote "cb" :force t :branch "default"))))
 (clean ()
  (probe-delete-directory ".stash" :recursive t)
  (vc-purge (vc *project*))
  (mapc 'delete-file (directory "**/*.fasl"))
  (mapc 'delete-file (directory "**/*.elc")))
 (psl.dat (%stash)
  "Fetch a public suffix list from publicsuffix.org."
  (reset :ssl)
  (init :ssl)
  (req:fetch "https://publicsuffix.org/list/public_suffix_list.dat"
   ".stash/psl.dat"
   :if-exists nil))
 (kbd.sxp (%stash)
  (req:fetch "https://packy.compiler.company/data/kbd.sxp"
   ".stash/kbd.sxp"
   :if-exists nil))
 #+nil
 (ccadb.dat (%stash)
  (unless (probe-file ".stash/cert.csv")
   (req:fetch "https://ccadb.my.salesforce-sites.com/ccadb/AllCertificateRecordsCSVFormatv5"
    ".stash/cert.csv")
   (loop for i from 1994 to (time:timestamp-year (time::today))
    do (req:fetch 
        (format nil "https://ccadb.my.salesforce-sites.com/ccadb/AllCertificatePEMsCSVFormat?NotBeforeYear=~A" i) 
        (format nil ".stash/pem-~A.csv" i) :if-exists :append))))
 (rgb.txt (%stash)
  (req:fetch "https://raw.githubusercontent.com/rgb-x/system/refs/heads/master/root/etc/X11/rgb.txt"
   ".stash/rgb.txt"
   :if-exists nil))
 (x11.lisp (rgb.txt)
  (color::parse-x11-palette
   :input ".stash/rgb.txt"
   :output "lib/obj/color/x11.lisp"))
 (parquet.thrift (%stash)
  (req:fetch
   "https://raw.githubusercontent.com/apache/parquet-format/master/src/main/thrift/parquet.thrift"
   ".stash/parquet.thrift"
   :if-exists nil)
  #$thrift --gen json -out .stash .stash/parquet.thrift$#)
 (parquet.json (%stash)
  (req:fetch "https://packy.compiler.company/data/parquet.json"
   ".stash/parquet.json"
   :if-exists nil))
 (freedesktop.org.xml (%stash)
  (req:fetch "https://packy.compiler.company/data/freedesktop.org.xml"
   ".stash/freedesktop.org.xml"
   :if-exists nil))
 (parquet-test-data (%stash) 
  (req:fetch "https://packy.compiler.company/data/test/alltypes_plain.parquet"
   ".stash/alltypes_plain.parquet"
   :if-exists nil))
 (sndfile-test-data (%stash)
  (req:fetch "https://packy.compiler.company/data/test/Weltschmerz.wav"
   ".stash/Weltschmerz.wav"
   :if-exists nil))
 (ffmpeg-test-data (%stash)
  (req:fetch "https://packy.compiler.company/data/test/my_seat_and_weep.flac"
   ".stash/my_seat_and_weep.flac"
   :if-exists nil))
 (test-data (ffmpeg-test-data sndfile-test-data parquet-test-data))
 (%stash () (ensure-directories-exist ".stash/"))
 (ssl-certs () 
  #$openssl req -new -x509 -days 365 -subj / -keyout .stash/private-key.pem \
  -passout pass:1234 -out .stash/certificate.pem -outform PEM$#)
 (ssl-client-certs ()
  #$openssl req -new -nodes -x509 -days 365 -subj / \
  -keyout .stash/client-key.pem -outform PEM \
  -out .stash/client-cert.pem$#)
 (emacs ()
  (:autoload () (funcall #0$sudo emacs -Q --script etc/script/gen-autoloads.el$# :input t))
  (:install () 
   (funcall #0$sudo mkdir -pv $EMACS_HOME/{site-lisp/slime,lisp,native-lisp}$# :input t)
   (funcall #0$sudo cp -rf etc/emacs/* $EMACS_HOME/site-lisp/$# :input t)
   (funcall #0$sudo cp -rf lib/swank/loader.lisp $EMACS_HOME/site-lisp/slime/$# :input t)
   (exec (project-find "autoload-emacs" *project*)))
  (:clean () 
   #$rm -rf $XDG_CONFIG_HOME/emacs/{*.el,lisp,site-lisp,lib,elpa,auto-save*,.cache,eln-cache,ielm-history.eld,tramp,transient,eshell,newsticker,emms,network-security.data,TAGS}$#)
  (:purge (clean-emacs)
   (funcall #0$sudo rm -rf $EMACS_HOME/site-lisp$# :input t)))
 (core ()
  (:build (%stash) 
   (run-program (find-exe "sbcl")
    (list "--noinform" "--no-userinit" "--no-sysinit" "--script" "bootstrap.lisp")
    :input t :output t))
  (:rebuild (%stash)
   (with-core (:input t :no-userinit t :no-sysinit t)
    (init :sys)
    (setq *stash* (probe-directory ".stash/"))
    ;; post-load hooks
    ;; (funcall (find-symbol "LOAD-XKBCOMMON" :xkb)) ; requires xkbcommon.so
    ;; (funcall (find-symbol "LOAD-XKB-KEYSYMS-FILE" :io/kbd) ".stash/kbd.sxp")
    (load-system :core)
    (make-system :core)))
  (:compile () (compile-lisp :core :force t :verbose t))
  (:install () (funcall #0$sudo etc/script/install.lisp$# :input t)))
 (tests ()
  (:run ()
   (load-system :ironclad)
   (load-system :ironclad/*)
   (load-system :ironclad/tests)
   (load-system :core/tests)
   (rt:run-all-tests t))
  (:save () 
   (with-sbcl (:noinform t :quit t :input t)
    (load-system :core/tests)
    (compile-lisp :core/tests :save ".stash/tests.core")))
  (:compile () 
   (compile-lisp :core/tests :force t :verbose t)))
 (coverage ()
  (with-sbcl (:noinform t :quit t :input t)
   (require :sb-cover)
   (declaim (optimize sb-cover:store-coverage-data))
   (compile-system :core :force t)
   (test-system :core :force t)
   (declaim (optimize sb-cover:store-coverage-data))
   (sb-cover:report ".stash/coverage/")
   (sb-cover:clear-coverage)))
 ;; install
 (install (install-core))
 (syms.sxp () 
  (with-open-file (f "syms.sxp" 
                   :direction :output
                   :if-exists :supersede
                   :if-does-not-exist :create)
   (dolist (s (list-all-symbols))
    (print s f))))
 (dist ()
  (ensure-directories-exist ".stash/cache/tmp/" :verbose t)
  (with-directory ".stash"
   (compress-file "core" "core.zst")))
 (dist-repo ()
  (vc-bundle (vc *project*) "/opt/store/packy/vc/core.hg"))
 (dist-source ()
  (with-directory ".."
   #$tar --exclude='.hg' --exclude='.stash' --exclude='*.tar.zst' --exclude='#*#' -I 'zstd' -cf ./core/core.tar.zst core/$#))
 (docs ()
  (:build ()
   (let ((*document-multi-file* t))
    (time (publish (project-documentation)
           :output #p".stash/api.org" 
           ;; :info t 
           :setupfile "../../clean.theme")))))
 (deploy (dist dist-repo)
  (move-file ".stash/core.zst" "/opt/store/packy/dist/x86_64/core.zst")
  (make *project* :dist-source)
  (when-let ((f (probe-file "core.tar.zst")))
  (move-file f "/opt/store/packy/src/core.tar.zst"))))
