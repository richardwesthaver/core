;;; skelfile --- CC/core skelfile -*- mode: skel; -*-
:name "core"
:author ("Richard Westhaver" . "ellis@rwest.io>")
:version "0.1.0"
:license "MPL"
:stash ".stash"
:store ".store"
:description "The Compiler Company Core"
:tags ("core" "lisp" "rust" "emacs" "c")
:include ("lisp.sk" "rust.sk" "emacs.sk")
:vc (:hg "https://vc.compiler.company/comp/core")
:scripts ((:lisp "x.lisp"))
:env ((cc "clang"))
:components ((:dir-locals ".dir-locals")
             (:org "readme"))
:rules
((all (%stash
       psl.dat parquet.json
       compile std prelude user
       infra core tests rdb
       skel organ homer packy
       fasl rust-bin tree-sitter-alien))
 (clean ()
        #$rm -vrf .stash$#
        #$find emacs -name '*.elc' -type f -delete$#
        #$find lisp -name '*.fasl' -type f -delete$#
        #$echo 'cargo clean:' && cd rust && cargo clean$#)
 (tree-sitter-alien () #$cd lisp/ffi/tree-sitter &&
                    clang -g -O2 -Wall -Wno-unused-value -ltree-sitter -shared \
                    alien.c -o ../../../.stash/libtree-sitter-alien.so$#)
 (tree-sitter-alien-install () #$cp .stash/libtree-sitter-alien.so /usr/local/lib/$#)
 (psl.dat ()
          (net/fetch:download "https://publicsuffix.org/list/public_suffix_list.dat" :output ".stash/psl.dat"))
 (parquet.thrift ()
                 (net/fetch:download
                  "https://raw.githubusercontent.com/apache/parquet-format/master/src/main/thrift/parquet.thrift"
                  :output ".stash/parquet.thrift")
                 #$thrift --gen json -out .stash .stash/parquet.thrift$#)
 (parquet.json ()
               (net/fetch:download "https://packy.compiler.company/data/parquet.json"
                                   :output ".stash/parquet.json"))
 (parquet-test-data () (net/fetch:download "https://packy.compiler.company/data/test/alltypes_plain.parquet"
                                           :output ".stash/alltypes_plain.parquet"))
 ;; lisp
 (%stash () #$mkdir -pv .stash$#)
 (rdb (%stash) (with-sbcl (:noinform t :quit t)
                 (ql:quickload :bin/rdb)
                 (asdf:make :bin/rdb)
                 #0$mv lisp/bin/rdb .stash/$#))
 (skel (%stash) (with-sbcl (:noinform t :quit t)
                  (ql:quickload :bin/skel)
                  (asdf:make :bin/skel)
                  #0$mv lisp/bin/skel .stash/$#))
 (skel-gui (%stash) (with-sbcl (:noinform t :quit t)
                      (push :tools *features*)
                      (ql:quickload :bin/skel)
                      (asdf:make :bin/skel)
                      #0$mv lisp/bin/skel .stash/$#))
 (organ (%stash) (with-sbcl (:noinform t :quit t)
                     (ql:quickload :bin/organ)
                     (asdf:make :bin/organ)
                   #0$mv lisp/bin/organ .stash/$#))
 (homer (%stash) (with-sbcl (:noinform t :quit t)
                   (ql:quickload :bin/homer)
                   (asdf:make :bin/homer)
                   #0$mv lisp/bin/homer .stash/$#))
 (packy (%stash) (with-sbcl (:noinform t :quit t)
                   (ql:quickload :bin/packy)
                   (asdf:make :bin/packy)
                   #0$mv lisp/bin/packy .stash/$#))
 (build (rdb skel organ homer packy))
 (compile () #$./x.lisp compile$#)
 (std () #$./x.lisp save std$#)
 (prelude () #$./x.lisp save prelude$#)
 (user () #$./x.lisp save user$#)
 (infra () #$./x.lisp save infra$#)
 (core () #$./x.lisp save core$#)
 (tests () #$./x.lisp save tests$#)
 (prelude-fasl () #$./x.lisp make prelude$#)
 (user-fasl () #$./x.lisp make user$#)
 (core-fasl () #$./x.lisp make core$#)
 (tests-fasl () #$./x.lisp make core/tests$#)
 (bench-fasl () #$./x.lisp make core/bench$#)
 (fasl (core-fasl tests-fasl bench-fasl user-fasl prelude-fasl))
 ;; rust
 (mailman () #$cd rust && cargo build -Z unstable-options --bin mailman --artifact-dir ../.stash/$#)
 (alik () #$cd rust && cargo build -Z unstable-options --bin alik --artifact-dir ../.stash/$#)
 (rust-bin (mailman alik))
 (alik-ui () #$trunk build --config rust/ui/alik/Trunk.toml$#)
 ;; install
 (install () #$d=/usr/local/bin
          cd .stash
          for f in $(find . -type f ! -name "*.*")
          do echo "$(basename $f) -> $d"
          install -C -m 755 $f $d
          done
          d=/usr/local/share/lisp
          if [ -d $d ];
          then
          for f in $(find . -type f -name "*.core")
          do echo "$(basename $f) -> $d"
          install -C -m 755 $f $d
          done fi$#)
 (emacs () #$make -C emacs$#)
 (dist () #$cd .stash
       mkdir -pv core/bin core/share/lisp/fasl core/lib
       mv *.core core/share/lisp/
       mv *.fasl core/share/lisp/fasl/
       mv *.so core/lib/
       mv $(find -maxdepth 1 -type f ! -name "*.*") core/bin/
       tar -I 'zstd' -cf core.tar.zst core/*$#)
 (dist-clean (clean) #$cd .. && tar -I 'zstd' -cf core/core-source.tar.zst core/* && cd core
             mkdir -pv .stash
             mv core-source.tar.zst .stash/$#))
