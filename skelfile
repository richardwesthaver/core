;;; skelfile --- CC/core skelfile -*- mode: skel; -*-
:name "core"
:author ("Richard Westhaver" . "ellis@rwest.io")
:version "0.1.0"
:license "MPL"
:stash ".stash"
:store ".store"
:description "The Compiler Company Core"
:tags ("core" "lisp" "rust" "emacs" "c")
:include ("lisp/lisp.sk" "rust/rust.sk" "emacs/emacs.sk")
:vc (:hg "https://vc.compiler.company/core"
         (cb (:git "ssh://git@codeberg.org/c-c/core"))
         (gh (:git "ssh://git@github.com/richardwesthaver/core")))
:bind ((stash ".stash")
       ;; (cc :env "clang")
       (emacs-locals :dir-locals
                     (nil . ((indent-tabs-mode . nil)))
                     (rust-mode . ((eglot-workspace-configuration
                                    . (:rust-analyzer (:cargo (:buildScripts (:enable t) (:features "all")))))))
                     (nushell-mode . ((nushell-indent-offset . 2)))
                     (nushell-ts-mode . ((nushell-indent-offset . 2)))
                     (sh-mode . (sh-indentation . 2))
                     (makefile-mode . ((indent-tabs-mode . t)))
                     (slint-mode . ((slint-indent-level . 2)))))
:components ((:org "readme")
             (:mod "emacs")
             (:mod "lisp")
             (:mod "rust"))
:rules
((all (%stash
       ;; psl.dat parquet.json rgb.txt
       ;; save-std save-prelude save-user fasls
       ;; save-infra save-tests
       build-zstd-alien
       build-tree-sitter-alien
       build-all-core 
       ;; rust-bin
       ))
 (upstream () ;; pretty gross hack to fix broken tree
           (vc:hg-fast-export (sk-vc *skel-project*))
           #$cd /tmp/core
           git remote add cb ssh://git@codeberg.org/c-c/core
           git remote add gh ssh://git@github.com/richardwesthaver/core
           git filter-repo --invert-paths --path std --force
           git push -u cb default --force
           git push gh default --force$#)
 (clean ()
        #$rm -vrf .stash$#
        #$find emacs -name '*.elc' -type f -delete$#
        #$find lisp -name '*.fasl' -type f -delete$#
        #$echo 'cargo clean:' && cd rust && cargo clean$#)
 (readme ()
         (:update ()
                  (cli/ed:with-emacs (e)
                    (org-babel-lob-ingest \"~/comp/org/meta/babel.org\")
                    (org-with-file-buffer \"~/comp/core/readme.org\"
                                          (goto-line 7)
                                          (org-ctrl-c-ctrl-c)
                                          (save-buffer)))))
 (swank ()
        (:run () 
              (let ((f ".stash/.swank"))
                (when (probe-file f)
                  (delete-file f))
                (swank:start-server f))))
 (tree-sitter-alien ()
                    (:build () #$cd lisp/ffi/tree-sitter &&
                            cc -g -O2 -Wall -Wno-unused-value -ltree-sitter -shared \
                            alien.c -o ../../../.stash/libtree-sitter-alien.so$#)
                    (:install () (funcall #$sudo -S cp .stash/libtree-sitter-alien.so /usr/local/lib/$# :input t)))
 (zstd-alien ()
             (:build () #$cd lisp/ffi/zstd &&
                     clang -g -O2 -Wall -Wno-unused-value -lzstd -shared \
                     alien.c -o ../../../.stash/libzstd-alien.so$#)
             (:install () (funcall #$sudo -S cp .stash/libzstd-alien.so /usr/local/lib/$# :input t)))
 (psl.dat (%stash)
          (download "https://publicsuffix.org/list/public_suffix_list.dat"
                    :output ".stash/psl.dat"
                    :if-exists :supersede))
 (rgb.txt (%stash)
          (download "https://packy.compiler.company/data/rgb.txt"
                    :output ".stash/rgb.txt"
                    :if-exists :supersede))
 (x11.lisp (rgb.txt)
           (color::parse-x11-color-definitions
            :input ".stash/rgb.txt"
            :output "lisp/lib/obj/color/x11.lisp"))
 (parquet.thrift (%stash)
                 (download
                  "https://raw.githubusercontent.com/apache/parquet-format/master/src/main/thrift/parquet.thrift"
                  :output ".stash/parquet.thrift"
                  :if-exists :supersede)
                 #$thrift --gen json -out .stash .stash/parquet.thrift$#)
 (parquet.json (%stash)
               (download "https://packy.compiler.company/data/parquet.json"
                         :output ".stash/parquet.json"
                         :if-exists :supersede))
 (freedesktop.org.xml (%stash)
                      (download "https://packy.compiler.company/data/freedesktop.org.xml"
                                :output ".stash/freedesktop.org.xml"))
 (parquet-test-data (%stash) (download "https://packy.compiler.company/data/test/alltypes_plain.parquet"
                                       :output ".stash/alltypes_plain.parquet"
                                       :if-exists :supersede))
 ;; lisp
 (%stash () #$mkdir -pv .stash$#)

 (ssl-certs () #$openssl req -new -x509 -days 365 -subj / -keyout .stash/private-key.pem \
            -passout pass:1234 -out .stash/certificate.pem -outform PEM$#)
 (ssl-client-certs () #$openssl req -new -nodes -x509 -days 365 -subj / \
                   -keyout .stash/client-key.pem -outform PEM \
                   -out .stash/client-cert.pem$#)

 (swm (%stash)
      (:build ()
              (with-sbcl (:noinform t :quit t)
                (push :x11 *features*)
                (push :clim *features*)
                (ql:quickload :bin/swm)
                (asdf:make :bin/swm))
              #$mv lisp/bin/swm .stash/swm$#)
      (:install () (funcall #$sudo -S install -C -m 755 .stash/swm /usr/local/bin/swm$# :input t)))
 (rdb (%stash)
      (:build ()
              (with-sbcl (:noinform t :quit t)
                (ql:quickload :bin/rdb)
                (asdf:make :bin/rdb))
              #$mv lisp/bin/rdb .stash/rdb$#)
      (:install () (funcall #$install -C -m 755 .stash/rdb /usr/local/bin/rdb$# :input t)))
 (skel (%stash)
       (:build ()
               (with-sbcl (:noinform t :quit t)
                 (ql:quickload :bin/skel)
                 (asdf:make :bin/skel))
               #$mv lisp/bin/skel .stash/skel$#)
       (:build-gui ()
                   (with-sbcl (:noinform t :quit t)
                     (push :gui *features*)
                     (push :tools *features*)
                     (ql:quickload :bin/skel)
                     (asdf:make :bin/skel))
                   #$mv lisp/bin/skel .stash/skel$#)
       (:install () (funcall #$sudo -S install -C -m 755 .stash/skel /usr/local/bin/skel$# :input t)))
 (skc (%stash)
      (:build ()
              (with-sbcl (:noinform t :quit t)
                (push :net *features*)
                (ql:quickload :std)
                (std:save-lisp-tree-shake-and-die "foo")
                (asdf:make :bin/skc))
              #$mv lisp/bin/skc .stash/skc$#))
 (vc (%stash)
     (:build ()
             (with-sbcl (:noinform t :quit t)
               (push :cli *features*)
               (ql:quickload :bin/vc)
               (asdf:make :bin/vc))
             #$mv lisp/bin/vc .stash/vc$#))
 (organ (%stash)
        (:build () (with-sbcl (:noinform t :quit t)
                     (ql:quickload :bin/organ)
                     (asdf:make :bin/organ))
                #$mv lisp/bin/organ .stash/organ$#))
 (homer (%stash)
        (:build () (with-sbcl (:noinform t :quit t)
                     (ql:quickload :bin/homer)
                     (asdf:make :bin/homer))
                #$mv lisp/bin/homer .stash/homer$#))
 (gen (%stash)
   (:build () (with-sbcl (:noinform t :quit t)
                (ql:quickload :bin/gen)
                (asdf:make :bin/gen)
                #$mv lisp/bin/gen .stash/gen$#)))
 (packy (%stash)
        (:build () (with-sbcl (:noinform t :quit t)
                     (ql:quickload :bin/packy)
                     (asdf:make :bin/packy))
                #$mv lisp/bin/packy .stash/packy$#))
 (std () (:save () (with-sbcl (:noinform t :quit t)
                     (ql:quickload :std)
                     (in-package :std-user)
                     (compile-lisp :std :save ".stash/std.core"))))
 (prelude ()
          (:save () (with-sbcl (:noinform t :quit t)
                      (ql:quickload :prelude)
                      (in-package :std-user)
                      (compile-lisp :prelude :save ".stash/prelude.core")))
          (:compile () (compile-lisp :prelude :force t :verbose t)))
 (user ()
       (:save () (with-sbcl (:noinform t :quit t)
                   (ql:quickload :user)
                   (in-package :user)
                   (compile-lisp :user :save ".stash/user.core")))
       (:compile () (compile-lisp :user :force t :verbose t)))
 (infra () (:save () (with-sbcl (:noinform t :quit t)
                       (ql:quickload :user)
                       (in-package :user)
                       (compile-lisp :user :save ".stash/infra.core" :compression 22))))
 (core ()
       (:build (%stash) (with-sbcl (:noinform t :quit t)
                          (push :virt *features*)
                          (push :tools *features*)
                          (asdf:load-system :bin/core)
                          (asdf:make :bin/core))
               #$mv lisp/bin/core .stash/core$#)
       (:build-all (%stash) (with-sbcl (:noinform t :quit t)
                              (push :virt *features*)
                              (push :net *features*)
                              (push :swank *features*)
                              (push :gui *features*)
                              (push :x11 *features*)
                              (push :clim *features*)
                              (push :tools *features*)
                              (asdf:load-system :core)
                              (asdf:make :bin/core))
                   #$mv lisp/bin/core .stash/core$#)
       (:save () (with-sbcl (:noinform t :quit t)
                   (ql:quickload (list :std :core))
                   (in-package :std-user)
                   (compile-lisp :core :save ".stash/core.core")))
       (:compile () (compile-lisp :core :force t :verbose t))
       (:install () (funcall #$sudo -S install -C -m 755 .stash/core /usr/local/bin/core
                             echo "core -> /usr/local/bin/"
                             links="skel homer packy rdb organ vc gen swm"
                             for i in $links; do
                             sudo ln -sf /usr/local/bin/core /usr/local/bin/$i
                             echo "$i -> core -> /usr/local/bin/"
                             done$#
                             :input t))
       (:link-pod () (funcall #$sudo -S ln -sf /usr/local/bin/core /usr/local/bin/pod$# :input t)))
 (tests ()
        (:save () (with-sbcl (:noinform t :quit t)
                    (ql:quickload :core/tests)
                    (in-package :core/tests)
                    (compile-lisp :core/tests :save ".stash/tests.core")))
        (:compile () 
                  (compile-lisp :core/tests :force t :verbose t)))
 (bench () (:compile () (compile-lisp :core/bench :force t :verbose t)))
 (fasls (compile-core #+nil compile-tests compile-bench compile-user compile-prelude))
 ;; rust
 (mailman () #$cd rust && cargo build -Z unstable-options --bin mailman --artifact-dir ../.stash/$#)
 (alik () #$cd rust && cargo build -Z unstable-options --bin alik --artifact-dir ../.stash/$#)
 (rust-bin (mailman alik))
 (alik-ui () #$trunk build --config rust/ui/alik/Trunk.toml$#)
 ;; install
 (install (install-core) 
          (funcall
           #$d=/usr/local/share/lisp/
           cd .stash
           if [ -d $d ];
           then
           for f in $(find . -type f -name "*.core")
           do echo "$(basename $f) -> $d"
           sudo -S install -C -m 755 $f $d
           done fi$#
           :input t))
 ;; TODO 2024-09-15: 
 (syms.sxp () 
                (with-open-file (f "syms.sxp" :direction :output 
                                                        :if-exists :overwrite 
                                                        :if-does-not-exist :create)
                  (dolist (s (list-all-symbols))
                    (print s f))))
 (dist () #$mkdir -pv .stash/tmp/core
       cd .stash
       mv *.so tmp/core/
       mv $(find -maxdepth 1 -type f ! -name "*.*") tmp/core/
       cd tmp && tar -I 'zstd' -cf core.tar.zst core/* && mv core.tar.zst ../$#)
 (dist-source (clean) #$cd .. && tar --exclude='.hg' --exclude='#*#' -I 'zstd' -cf core/core.tar.zst core/*$#)
 (dist-core (clean %stash build-core) #$zstd .stash/core$#))
