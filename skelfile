    (push :tools *features*)
    (asdf:load-system :core)
    (in-package :std-user)
    (compile-lisp :core :save ".stash/all.core")))
  (:compile () (compile-lisp :core :force t :verbose t))
  (:install () 
   (funcall 
    #$sudo -S install -C -m 755 .stash/core /usr/local/bin/core
    echo "core -> /usr/local/bin/"
    links="skel homer packy rdb organ vc gen swm mpk"
    for i in $links; do
    sudo ln -sf /usr/local/bin/core /usr/local/bin/$i
    echo "$i -> core -> /usr/local/bin/"
    done$#
    :input t))
  (:install-gui ()
   (funcall 
    #$sudo -S install -C -m 755 .stash/gui /usr/local/bin/gui
    echo "gui -> /usr/local/bin/"$#
    :input t))
