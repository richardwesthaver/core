;;; skelfile --- CC/core skelfile -*- mode: skel; -*-
:name "core"
:author "Richard Westhaver <ellis@rwest.io>"
:version "0.1.0"
:license "MPL"
:stash ".stash"
:store ".store"
:description "The Compiler Company Core"
:tags ("core" "lisp" "rust" "emacs" "c")
:imports ("lisp/skelfile" "rust/skelfile" "emacs/skelfile" "c/skelfile")
:vc (:hg "https://vc.compiler.company/comp/core")
:docs ((:org "readme"))
:scripts ((:lisp "x"))
:env ((cc "clang"))
:rules
((all (compile std prelude user infra core tests build fasl rust-bin)) ;; TODO: add keyword args -- (emacs :stage 'install) 
 (clean ()
        #$rm -vrf .stash$#
        #$find emacs -name '*.elc' -type f -delete$#
        #$find lisp -name '*.fasl' -type f -delete$#
        #$echo 'cargo clean:' && cd rust && cargo clean$#)
 (box () #$podman build . --build-arg IMAGE=box -t core$#)
 (tree-sitter-alien ()
                    #$ cd lisp/ffi/tree-sitter &&
                    clang -g -O2 -Wall -Wno-unused-value -ltree-sitter -shared \
                    alien.c -o /usr/local/lib/libtree-sitter-alien.so$#
                    (info! "installed /usr/local/lib/libtree-sitter-alien.so"))
 (psl.dat () ;; req:fetch works in slime and sk-shell but not here? hmm..
          (with-open-file
           (st ".stash/psl.dat" :direction :output :element-type 'octet)
           (loop for x across (req:get "https://publicsuffix.org/list/public_suffix_list.dat" :force-binary t)
                 do (write-byte x st))))
 ;; lisp
 (rdb () #$./x.lisp build rdb$#)
 (skel () #$./x.lisp build skel$#)
 (organ () #$./x.lisp build organ$#)
 (homer () #$./x.lisp build homer$#)
 (packy () #$./x.lisp build packy$#)
 (build () #$./x.lisp build$#)
 (compile () #$./x.lisp compile$#)
 (std () #$./x.lisp save std$#)
 (prelude () #$./x.lisp save prelude$#)
 (user () #$./x.lisp save user$#)
 (infra () #$./x.lisp save infra$#)
 (core () #$./x.lisp save core$#)
 (tests () #$./x.lisp save tests$#)
 (prelude-fasl () #$./x.lisp make prelude$#)
 (user-fasl () #$./x.lisp make user$#)
 (core-fasl () #$./x.lisp make core$#)
 (tests-fasl () #$./x.lisp make core/tests$#)
 (bench-fasl () #$./x.lisp make core/bench$#)
 (fasl (core-fasl tests-fasl bench-fasl user-fasl prelude-fasl))
 ;; rust
 (mailman () #$cd rust && cargo build -Z unstable-options --bin mailman --out-dir ../.stash/$#)
 (krypt () #$cd rust && cargo build -Z unstable-options --bin krypt --out-dir ../.stash/$#)
 (alik () #$cd rust && cargo build -Z unstable-options --bin alik --out-dir ../.stash/$#)
 (rust-bin (mailman krypt alik))
 (alik-ui () #$trunk build --config rust/ui/alik/Trunk.toml$#)
 ;; install
 (install () #$d=/usr/local/bin
          cd .stash
          for f in $(find . -type f ! -name "*.*")
          do echo "$(basename $f) -> $d"
          install -C -m 755 $f $d
          done
          d=/usr/local/share/lisp
          if [ -d $d ];
          then
          for f in $(find . -type f -name "*.core")
          do echo "$(basename $f) -> $d"
          install -C -m 755 $f $d
          done fi$#)
 (emacs-user () #$make -C emacs$#)
 (dist () #$cd .stash
       mkdir -pv core/bin core/share/lisp/fasl
       mv *.core core/share/lisp/
       mv *.fasl core/share/lisp/fasl/
       mv $(find -maxdepth 1 -type f ! -name "*.*") core/bin/
       tar -I 'zstd' -cf core.tar.zst core/*$#)
 (dist-clean (clean) #$cd .. && tar -I 'zstd' -cf core/core-source.tar.zst core/* && cd core
             mkdir -pv .stash
             mv core-source.tar.zst .stash/$#))
