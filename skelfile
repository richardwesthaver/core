   :input ".stash/rgb.txt"
   :output "lib/obj/color/x11.lisp"))
 (lapack-ffi.lisp ()
  (tree-sitter:load-tree-sitter)
  (tree-sitter:load-tree-sitter-alien)
  (tree-sitter:load-tree-sitter-c)
  (let (lapack lapack.h code)
   (setf
    lapack
    (let* ((str (read-file #p"/usr/include/openblas/lapack.h"))
  	   (tree (flatten (syn/ts::parse-string :c str :consume t :produce-cst nil)))
  	   (ret))
     (setf lapack.h str)
     (loop with dx = 0
      for di = (position :declaration tree :start dx)
      if (null di) 
      do (return ret)
      else
      do (progn
          (setf dx di)
          (incf dx)
          (let ((ei (position :declaration tree :start dx)))
           (push (subseq tree di ei) ret))))))
   (labels ((lastr (x start end)
             (apply 'subseq lapack.h (subseq x start end)))
            (lasym (str) (symbolicate (string-upcase (substitute #\- #\_ str))))
            (lasym* (str)
             (let ((len (length str)))
              (list '* (lasym (subseq str 0 
                               (if (char= (char str (1- len)) #\*)
                                (1- len)
                                len))))))
  	    (lasyms (x start end)
  	     (symbolicate (string-upcase (substitute #\- #\_ (lastr x start end)))))
            (lasymf (x start end)
             (symbolicate (string-upcase (substitute #\- #\_ (remove-string "LAPACK_" (lastr x start end))))))
  	    (laparm (str)
  	     (let ((a (nreverse (split-sequence #\space str))))
  	      (list (if (string-equal (first a) "T")
                     '%t
                     (lasym (first a)))
               (if (third a)
                ;; type param (could be X const* or const X*)
                (if (string-equal (third a) "const")
                 (lasym* (second a))
                 (lasym* (third a)))
                (when (second a)
                 (lasym* (second a)))))))
            (gen-lapack-args (x)
             (let* ((pa (position :parameter-list x)) ;; param start
  	            (pb (position :preproc-ifdef x)) ;; param end
  	            (params (subseq x pa pb)))
  	      (loop with p1 = 0
  	       for pos = (position :parameter-declaration params :start p1)
  	       while pos
  	       do (setf p1 (1+ pos))
  	       collect (laparm (lastr params (+ pos 1) (+ pos 3)))))))
    (setf code
     (mapcar
      (lambda (x)
       (let ((p (position :function-declarator x)))
        (list* 'deflapack
         ;; routine name
         (lasymf x (+ p 5) (+ p 7))
         ;; return-type
         (lasyms x (- p 3) (- p 1))
         ;; list of function parameters (NAME TYPE)
         (remove-if (lambda (x) (eql (car x) 'fortran-strlen)) (gen-lapack-args x)))))
      lapack)))
   (with-output-to-file (f (asdf:system-relative-pathname :lapack "lapack-ffi.lisp") :if-exists :supersede)
    (write-line ";;; lapack-ffi.lisp --- LAPACK Alien Routines -*- buffer-read-only:t -*-" f)
    (write-line "(in-package :lapack)" f)
    (mapc (lambda (x) (write x :stream f :case :downcase) (terpri f)) code))))
 (parquet.thrift (%stash)
  (req:fetch
   "https://raw.githubusercontent.com/apache/parquet-format/master/src/main/thrift/parquet.thrift"
   ".stash/parquet.thrift"
   :if-exists :supersede)
  #$thrift --gen json -out .stash .stash/parquet.thrift$#)
 (parquet.json (%stash)
  (req:fetch "https://packy.otom8.dev/data/parquet.json"
   ".stash/parquet.json"
   :if-exists :supersede))
 (freedesktop.org.xml (%stash)
  (req:fetch "https://packy.otom8.dev/data/freedesktop.org.xml"
   ".stash/freedesktop.org.xml"))
 (parquet-test-data (%stash) 
  (req:fetch "https://packy.otom8.dev/data/test/alltypes_plain.parquet"
   ".stash/alltypes_plain.parquet"
   :if-exists :supersede))
 (sndfile-test-data (%stash)
  (req:fetch "https://packy.otom8.dev/data/test/Weltschmerz.wav"
   ".stash/Weltschmerz.wav"
   :if-exists :supersede))
 (ffmpeg-test-data (%stash)
  (req:fetch "https://packy.otom8.dev/data/test/my_seat_and_weep.flac"
   ".stash/my_seat_and_weep.flac"
   :if-exists :supersede))
 (test-data (ffmpeg-test-data sndfile-test-data parquet-test-data))
 (%stash () (ensure-directories-exist ".stash/"))
 (ssl-certs () 
  #$openssl req -new -x509 -days 365 -subj / -keyout .stash/private-key.pem \
  -passout pass:1234 -out .stash/certificate.pem -outform PEM$#)
 (ssl-client-certs ()
  #$openssl req -new -nodes -x509 -days 365 -subj / \
  -keyout .stash/client-key.pem -outform PEM \
  -out .stash/client-cert.pem$#)
 (skel (%stash)
  (:build ()
   (with-sbcl (:noinform t :quit t :input t)
    (asdf:make :bin/skel))
   (move-file "bin/skel" ".stash/skel")))
 (skc (%stash)
  (:build ()
   (with-sbcl (:noinform t :quit t)
    (push :net *features*)
    (asdf:load-system :std)
    (asdf:make :bin/skc))
   (move-file "bin/skc" ".stash/skc")))
 (core ()
  (:build (%stash)
   (with-sbcl (:noinform t :quit t :input t)
    (let ((sb-ext:*block-compile-default* t))
     (pushnew 'asdf::clear-configuration *save-hooks*)
     (setf asdf:*central-registry* nil)
     (asdf:make :bin/core)))
   (move-file "bin/core" ".stash/core"))
  (:compile () (compile-lisp :core :force t :verbose t))
  (:install ()
   (with-sudo "install -C -m 755 .stash/core /usr/local/bin/core")
   (println "core -> /usr/local/bin/")
   (loop for i in '("skel" "homer" "mpk" "pod")
    while i
    do (with-sudo (format nil "ln -sf /usr/local/bin/core /usr/local/bin/~A" i))
    do (println (format nil "~A -> /usr/local/bin/core" i)))))
 (tests ()
  (:run ()
   (asdf:load-system :core/tests)
   (rt:run-all-tests t))
  (:save () 
   (with-sbcl (:noinform t :quit t)
    (asdf:load-system :core/tests)
    (compile-lisp :core/tests :save ".stash/tests.core")))
  (:compile () 
   (compile-lisp :core/tests :force t :verbose t)))
 (bench () 
  (:compile () (compile-lisp :core/bench :force t :verbose t))
  (:tpc-h () (asdf:load-system :core/bench) (symbol-call :core/bench/dbgen 'dbgen)))
 (coverage ()
  (with-sbcl (:noinform t :quit t :input t)
   (require :sb-cover)
   (declaim (optimize sb-cover:store-coverage-data))
   (asdf:compile-system :core :force t)
   (asdf:test-system :core :force t)
   (declaim (optimize sb-cover:store-coverage-data))
   (sb-cover:report ".stash/coverage/")
   (sb-cover:clear-coverage)))
 ;; install
 (install (install-core)
  (with-directory ".stash/"
   (loop for f in (directory "*.core")
    while f
    with d = #P"/usr/local/share/lisp/"
    do (format t "~A -> ~A" f d)
    do (sb-ext:run-program (find-exe "install") `("-C" "-m" "755" ,f ,d) :output t))))
 (syms.sxp () 
  (with-open-file (f "syms.sxp" 
                   :direction :output 
                   :if-exists :supersede
                   :if-does-not-exist :create)
   (dolist (s (list-all-symbols))
    (print s f))))
 (dist ()
  (ensure-directories-exist ".stash/tmp/core/" :verbose t)
  (with-directory ".stash"
   (mapc (lambda (x) (move-file x (merge-pathnames (file-namestring x) "tmp/core/"))) (directory "*.so"))
   (mapc (lambda (x) (move-file x (merge-pathnames (file-namestring x) "tmp/core/"))) (remove-if 'directory-path-p (directory "*")))
   (with-directory "tmp/"
    ;; (compress #p"core.tar" :zstd :output #p"core.tar.zst")
    #$tar -I 'zstd' -cf ./core.tar.zst core/$#))
  (move-file ".stash/tmp/core.tar.zst" ".stash/core.tar.zst"))
 (dist-repo ()
  (vc-bundle (sk-vc *skel-project*) "/opt/store/packy/vc/core.hg"))
 (dist-source ()
  (with-directory ".."
   #$tar --exclude='.hg' --exclude='.stash' --exclude='*.tar.zst' --exclude='#*#' -I 'zstd' -cf ./core/core.tar.zst core/$#))
 (deploy (dist)
  (move-file ".stash/core.tar.zst" "/opt/store/packy/dist/x86_64-unknown-linux-gnu/core.tar.zst")
  (sk-make *skel-project* :dist-source)
  (move-file "core.tar.zst" "/opt/store/packy/src/core.tar.zst")))
