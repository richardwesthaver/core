;;; skelfile --- CC/core skelfile -*- mode: skel; -*-
:name core
:author ("Richard Westhaver" . "ellis@rwest.io")
:version "0.1.1"
:license mpl
:stash ".stash"
:description "The Compiler Company Core"
:tags (core lisp emacs)
:vc (:hg "https://vc.compiler.company/core"
     (cb (:git "ssh://git@codeberg.org/c-c/core"))
     (gh (:git "ssh://git@github.com/richardwesthaver/core")))
:bind 
((stash ".stash")
 (cc :env "gcc")
 (emacs-locals
  :dir-locals
  (nil . ((indent-tabs-mode . nil)))
  (sh-mode . (sh-indentation . 2))
  (makefile-mode . ((indent-tabs-mode . t))))
 (packy-home :env "/opt/store/packy"))
:components 
((:org "readme")
 (:asd "core")
 (:sys "core")
 (:mod "std" (:sys "std"))
 (:mod "ffi" (:sys "ffi"))
 (:mod "lib")
 (:mod "bin" (:sys "bin"))
 (:mod "skel" (:sys "skel"))
 (:mod "emacs"))
:rules
((default (data rebuild-core))
 (data (%stash psl.dat kbd.sxp x11.lisp parquet.json))
 (all
  (%stash
   psl.dat x11.lisp kbd.sxp parquet.thrift
   rebuild-core
   deploy))
 (upstream () 
  (let ((tmp "/tmp/core/"))
   (probe-delete-directory tmp)
   (vc-export (vc *skel-project*) tmp :filter-regexp "^std$") ;; yuck
   (with-repo (r :path tmp :type :git)
    (vc-update r)
    (vc-submodule r :add :url "https://github.com/richardwesthaver/ppcre")
    (vc-submodule r :add :url "https://github.com/richardwesthaver/ironclad")
    (vc-remote r :add :name "cb" :url "ssh://git@codeberg.org/c-c/core")
    (vc-remote r :add :name "gh" :url "ssh://git@github.com/richardwesthaver/core")
    (vc-add r ".gitmodules")
    (vc-commit r "gitmodules")
    (vc-push r :set-upstream t :remote "cb" :branch "default" :force t)
    (vc-push r :remote "gh" :branch "default" :force t))))
 (clean ()
  (probe-delete-directory ".stash" :recursive t)
  (mapc 'delete-file (directory "**/*.fasl"))
  (mapc 'delete-file (directory "**/*.elc")))
 (readme ()
  (:update ()
   (with-emacs (e)
    (org-babel-lob-ingest company-babel-file)
    (org-with-file-buffer (join-paths company-source-directory "core/readme.org")
     (org-babel-execute-buffer)
     (save-buffer)))))
 (psl.dat (%stash)
  (reset :ssl)
  (init :ssl)
  (req:fetch "https://publicsuffix.org/list/public_suffix_list.dat"
   ".stash/psl.dat"
   :if-exists nil))
 (kbd.sxp (%stash)
  (req:fetch "https://packy.otom8.dev/data/kbd.sxp"
   ".stash/kbd.sxp"
   :if-exists nil))
 (ccadb.dat (%stash)
  (unless (probe-file ".stash/cert.csv")
   (req:fetch "https://ccadb.my.salesforce-sites.com/ccadb/AllCertificateRecordsCSVFormatv2"
    ".stash/cert.csv")
   (loop for i from 1994 to (time:timestamp-year (time::today))
    do (req:fetch 
        (format nil "https://ccadb.my.salesforce-sites.com/ccadb/AllCertificatePEMsCSVFormat?NotBeforeYear=~A" i) 
        (format nil ".stash/pem-~A.csv" i) :if-exists :append))))
 (rgb.txt (%stash)
  (req:fetch "https://raw.githubusercontent.com/rgb-x/system/refs/heads/master/root/etc/X11/rgb.txt"
   ".stash/rgb.txt"
   :if-exists nil))
 (x11.lisp (rgb.txt)
  (color::parse-x11-palette
   :input ".stash/rgb.txt"
   :output "lib/obj/color/x11.lisp"))
 (parquet.thrift (%stash)
  (req:fetch
   "https://raw.githubusercontent.com/apache/parquet-format/master/src/main/thrift/parquet.thrift"
   ".stash/parquet.thrift"
   :if-exists nil)
  #$thrift --gen json -out .stash .stash/parquet.thrift$#)
 (parquet.json (%stash)
  (req:fetch "https://packy.otom8.dev/data/parquet.json"
   ".stash/parquet.json"
   :if-exists nil))
 (freedesktop.org.xml (%stash)
  (req:fetch "https://packy.otom8.dev/data/freedesktop.org.xml"
   ".stash/freedesktop.org.xml"
   :if-exists nil))
 (parquet-test-data (%stash) 
  (req:fetch "https://packy.otom8.dev/data/test/alltypes_plain.parquet"
   ".stash/alltypes_plain.parquet"
   :if-exists nil))
 (sndfile-test-data (%stash)
  (req:fetch "https://packy.otom8.dev/data/test/Weltschmerz.wav"
   ".stash/Weltschmerz.wav"
   :if-exists nil))
 (ffmpeg-test-data (%stash)
  (req:fetch "https://packy.otom8.dev/data/test/my_seat_and_weep.flac"
   ".stash/my_seat_and_weep.flac"
   :if-exists nil))
 (test-data (ffmpeg-test-data sndfile-test-data parquet-test-data))
 (%stash () (ensure-directories-exist ".stash/"))
 (ssl-certs () 
  #$openssl req -new -x509 -days 365 -subj / -keyout .stash/private-key.pem \
  -passout pass:1234 -out .stash/certificate.pem -outform PEM$#)
 (ssl-client-certs ()
  #$openssl req -new -nodes -x509 -days 365 -subj / \
  -keyout .stash/client-key.pem -outform PEM \
  -out .stash/client-cert.pem$#)
 (emacs ()
  (:install ()
   (flet ((el-write (in out)
           (std:with-open-files
            ((in in :direction :input)
             (out out :direction :output :if-exists :supersede))
            (std:copy-stream in out :finish-output t))))
    (let ((dotemacs (merge-pathnames ".config/emacs/" (user-homedir-pathname)))
          (config (directory "emacs/*.el"))
          (lib (directory "emacs/lib/*.el")))
     (mapcar
      (lambda (el)
       (el-write el (merge-pathnames (file-namestring el) dotemacs)))
      config)
     (mapcar
      (lambda (el)
       (el-write el 
        (merge-pathnames (file-namestring el)
         (ensure-directories-exist 
          (merge-pathnames "lib/" dotemacs)))))
      lib))))
  (:purge () 
   #$rm -rf $XDG_CONFIG_HOME/emacs/{*.el,lisp,site-lisp,lib,elpa,auto-save*,.cache,eln-cache,ielm-history.eld,tramp,transient,eshell,newsticker,emms,network-security.data,TAGS}$#))
 (core ()
  (:build (%stash) (run-sbcl "--load" "bin/script/bootstrap.lisp"))
  (:rebuild (%stash)
   (with-core (:input t :no-userinit t :no-sysinit t)
    (init :sys)
    (setq *stash* (probe-directory ".stash/"))
    (compile-system :std)
    (load-system :std)
    (compile-system :core)
    (load-system :core)
    (compile-system :bin)
    (load-system :bin)
    ;; post-load hooks
    (funcall (find-symbol "LOAD-XKBCOMMON" :xkb)) ; requires xkbcommon.so
    (funcall (find-symbol "LOAD-XKB-KEYSYMS-FILE" :io/kbd) ".stash/kbd.sxp")
    (funcall (print (find-module :bin :bin)))))
  (:compile () (compile-lisp :core :force t :verbose t))
  (:install (install-emacs)
   (with-sudo "install -C -m 755 .stash/core /usr/local/bin/core")
   (let ((apps '("skel" "homer" "mpk" "pod")))
    (with-progress-bar ((length apps) "installing core to /usr/local/bin/core")
     (loop for i in apps
      while i
      do (with-sudo (format nil "ln -sf /usr/local/bin/core /usr/local/bin/~A" i))
      do (update! 1))))))
 (tests ()
  (:run ()
   (asdf:load-system :core/tests)
   (rt:run-all-tests t))
  (:save () 
   (with-sbcl (:noinform t :quit t)
    (asdf:load-system :core/tests)
    (compile-lisp :core/tests :save ".stash/tests.core")))
  (:compile () 
   (compile-lisp :core/tests :force t :verbose t)))
 (coverage ()
  (with-sbcl (:noinform t :quit t :input t)
   (require :sb-cover)
   (declaim (optimize sb-cover:store-coverage-data))
   (asdf:compile-system :core :force t)
   (asdf:test-system :core :force t)
   (declaim (optimize sb-cover:store-coverage-data))
   (sb-cover:report ".stash/coverage/")
   (sb-cover:clear-coverage)))
 ;; install
 (install (install-core)
  (with-directory ".stash/"
   (loop for f in (directory "*.core")
    while f
    with d = #P"/usr/local/share/lisp/"
    do (format t "~A -> ~A" f d)
    do (sb-ext:run-program (find-exe "install") `("-C" "-m" "755" ,f ,d) :output t))))
 (syms.sxp () 
  (with-open-file (f "syms.sxp" 
                   :direction :output
                   :if-exists :supersede
                   :if-does-not-exist :create)
   (dolist (s (list-all-symbols))
    (print s f))))
 (dist ()
  (ensure-directories-exist ".stash/tmp/core/" :verbose t)
  (with-directory ".stash"
   (mapc (lambda (x) (move-file x (merge-pathnames (file-namestring x) "tmp/core/"))) (directory "*.so"))
   (mapc (lambda (x) (move-file x (merge-pathnames (file-namestring x) "tmp/core/"))) (remove-if 'directory-path-p (directory "*")))
   (with-directory "tmp/"
    ;; (compress #p"core.tar" :zstd :output #p"core.tar.zst")
    #$tar -I 'zstd' -cf ./core.tar.zst core/$#))
  (move-file ".stash/tmp/core.tar.zst" ".stash/core.tar.zst"))
 (dist-repo ()
  (vc-bundle (vc *skel-project*) "/opt/store/packy/vc/core.hg"))
 (dist-source ()
  (with-directory ".."
   #$tar --exclude='.hg' --exclude='.stash' --exclude='*.tar.zst' --exclude='#*#' -I 'zstd' -cf ./core/core.tar.zst core/$#))
 (deploy (dist)
  (move-file ".stash/core.tar.zst" "/opt/store/packy/dist/x86_64-unknown-linux-gnu/core.tar.zst")
  (sk-make *skel-project* :dist-source)
  (move-file "core.tar.zst" "/opt/store/packy/src/core.tar.zst")))
