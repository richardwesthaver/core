;;; ~/comp/core/bin/bin.sys --- Executable Program Definitions
(defsys :bin
 :require (:log)
 :provide
 ((:bin :bin/homer :toplevel "skel/homer/cli::start-homer"
   :name "homer"
   :require (:homer))
  (:bin :bin/skel :toplevel "skel/cli::start-skel"
   :name "skel"
   :require (:skel))
  (:bin :bin/core :toplevel "bin/core::dispatch-core"
   :name "core"
   :require (:core)
   :components ((:file "core")))
  (:bin :bin/mpk :toplevel "mpk/cli::start-mpk"
   :name "mpk"
   :require (:mpk))))
