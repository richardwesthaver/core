;;; bootstrap.lisp --- Core Bootstrap Script

;; Bootstrap the core from a fresh SBCL installation.

;;; Commentary:

;; This script is intended for use with latest public release of SBCL.

;; from the project root:

;; sbcl --script bin/script/bootstrap.lisp 

;;; Code:
(in-package :cl-user)
(require 'sb-md5)
(require 'sb-sprof)
(require 'sb-cover)
(require 'sb-grovel)
(require 'sb-posix)
(require 'sb-bsd-sockets)
(require 'sb-cltl2)
(require 'sb-concurrency)
(require 'sb-introspect)
(require 'sb-rotate-byte)
(require 'asdf)
(require 'uiop)
(asdf:load-asd (probe-file "ppcre/ppcre.asd"))
(asdf:load-asd (probe-file "std/std.asd"))
(asdf:load-system :ppcre)
(asdf:load-system :std :force t)
(shadowing-import '(reset) :std)
(in-package :std-user)
(setq *stash* (make-pathname :directory (append (pathname-directory *default-pathname-defaults*) '(".stash"))))
(init :sys)
(load-system :ironclad/core)
(load-system :ironclad/ciphers)
(load-system :ironclad/digests)
(load-system :ironclad/macs)
(load-system :ironclad/prngs)
(load-system :ironclad/aeads)
(load-system :ironclad/kdfs)
(load-system :ironclad/public-keys)
(load-system :uring)
(load-system :xkb)
(load-system :evdev)
(load-system :btrfs)
(load-system :zstd)
(load-system :syslog)
(load-system :blake3)
(load-system :keyutils)
(load-system :tree-sitter)
(load-system :log)
(load-system :rocksdb)
(load-system :cuda)
(load-system :openssl)
(load-system :ssh2)
(load-system :io)
(load-system :dat)
(load-system :rt)
(load-system :jpeg)
(load-system :sndfile)
(load-system :alien)
(load-system :parse)
(load-system :cry)
(load-system :cli)
(load-system :rdb)
(load-system :organ)
(load-system :syn)
(load-system :net)
(load-system :math)
(load-system :dsp)
(load-system :skel)
(load-system :core)
(load-system :bin)
(init :kbd :keysyms (stash-pathname "kbd.sxp") :input nil)
(make-system :bin)
