;;; gstreamer.sys --- Gstreamer Sytem Definitions
(defsys :gstreamer
 :require (:std :log :glib)
 :components 
 ((:file "pkg")
  (:file "object" :require ("pkg"))
  (:file "clock" :require ("object"))
  (:file "mini-object" :require ("pkg"))
  (:file "caps" :require ("mini-object"))
  (:file "context" :require ("pkg"))
  (:file "task" :require ("object"))
  (:file "iterator" :require ("pkg"))
  (:file "message" :require ("mini-object"))
  (:file "bus" :require ("object" "message"))
  (:file "pad" :require ("object"))
  (:file "element" :require ("clock" "object" "iterator" "context"))
  (:file "parse" :require ("element"))
  (:file "element-factory" :require ("element"))
  (:file "bin" :require ("element"))
  (:file "pipeline" :require ("bin"))
  (:file "debug" :require ("bin"))
  (:file "play" :require ("element" "bin"))
  (:file "ges" :require ("element" "bin" "pipeline")))
 :provide ((:tests :require (:std :log :rt :gstreamer :glib))))
