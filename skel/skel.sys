;;; ~/comp/core/app/skel/skel.sys --- Skel Sytem Definitions
(defsys :skel
 :version "0.1.1"
 :require (:std :obj :dat :cli :organ :doc :vc :pod :net :box :rdb :syn :nlp)
 :components 
 ((:pkg "pkg" :internal-package :skel-int :feature :skel :default-package :sk-user)
  (:mod "core"
   :components 
   ((:file "condition")
    (:file "proto")
    (:file "header")
    (:file "var")
    (:file "obj")
    (:file "component")
    (:file "rule")
    (:file "project")
    (:file "pack")
    (:file "print")
    (:file "schema")
    (:file "db")
    (:file "log")
    (:file "util")))
  (:mod "comp"
   :components
   ((:file "lisp")
    (:file "asd")
    (:file "cargo")
    (:file "box")
    (:file "container")
    (:file "org")
    (:file "dir-locals")
    (:file "makefile")
    (:file "sys")
    (:file "infer")))
  (:file "net")
  (:file "srv")
  (:mod "packy"
   :components
   ((:pkg "pkg" 
     :feature :packy 
     :internal-package :skel-int 
     :default-package :pk-user)
    (:file "var")
    (:file "proto")
    (:file "pkgbuild")
    (:file "db")
    (:file "client")
    (:file "srv")
    (:file "cfg")
    (:file "cli")))
  (:mod "krypt"
   :components 
   ((:pkg "pkg" 
     :feature :krypt
     :internal-package :skel-int
     :default-package :kr-user)
    (:file "condition")
    (:file "var")
    (:file "cfg")
    (:file "util")
    (:file "cli")))
  (:mod "homer"
   :components 
   ((:pkg "pkg" 
     :feature :homer 
     :internal-package :skel-int
     :default-package :hr-user)
    (:file "var")
    (:file "log")
    (:file "util")
    (:file "task")
    (:file "cfg")
    (:file "srv")
    (:file "cli")))
  (:mod "mpk"
   :components
   ((:pkg "pkg" 
     :feature :mpk 
     :internal-package :skel-int
     :default-package :mk-user)
    (:file "mpd")
    (:file "var")
    (:file "proto" :require ("proto"))
    (:file "util")
    (:file "db")
    (:file "cfg")
    #+todo (:file "clean")
    (:file "net")
    (:file "metro")
    (:file "mpk")
    (:file "cli")))
  (:file "cli"))
 :provide ((:tests) (:bin)))
