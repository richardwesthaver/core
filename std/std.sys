;;; std.sys --- standard library

;; Standard library system definition

;;; Commentary:

;; Note that this file should ONLY be loaded after the STD/DEFSYS package has
;; been defined. To load the STD system on a fresh SBCL, load it from the ASD
;; file.

;;; Code:
(defsys :std
 :version "0.1.0"
 :description "CC Standard Library"
 :serial t
 :require (:cl-ppcre :std)
 :components 
 ("named-readtables" "defpkg" 
  (:dir "num")
  (:pkg "pkg")
  (:file "condition")
  (:file "sym")
  (:file "list")
  (:file "prim")
  (:file "kernel")
  (:file "type")
  (:file "string")
  (:file "stream")
  (:file "curry")
  (:file "array")
  (:file "hash")
  (:file "readtable")
  (:mod "macs"
   :components
   ((:file "ana")
    (:file "pan")
    (:file "collecting")
    (:file "loop")
    (:file "control")
    (:file "unit")
    (:file "sugar")))
  (:file "pipe")
  (:file "sys")
  (:file "serde")
  (:file "alien")
  (:file "comp")
  (:file "meta")
  (:file "bit")
  (:file "seq")
  (:file "thread")
  (:file "async")
  (:file "defpun")
  (:file "task")
  (:file "print")
  (:file "path")
  (:file "os")
  (:file "file")
  (:file "rand")
  (:file "defsys"))
 :provide
 (:std :defsys :defpkg :named-readtables ; features
  (:readtable :std)
  (:proto :serde)
  (:proto :pipe)
  (:proto :kernel)
  (:proto :verb)
  (:io :alien)
  (:tests :std/tests
   :require (:std :rt)
   :description "CC Standard Library Tests"
   :serial t
   :components 
   ((:mod "tests"
     :components
     ((:file "pkg")
      (:file "num")
      (:file "seq")
      (:file "pipe")
      (:file "thread")
      (:file "async")
      (:file "task")
      (:file "macs")))))
  (:prelude :alien* 
   :defar :define-alien-enum :sap :free)
  (:prelude :os*
   :current-user :sudo-p
   :forkable-p :user-info
   :list-all-users :list-all-groups
   :with-umask :with-fd :ioctl :xdg-user-dir
   :init-xdg-user-dirs :init-xdg-base-dirs
   :xdg-base-dir :user-add :group-add :file-kind
   :unmerge-pathnames :current-directory
   :with-directory-iterator :merge-env-pathnames
   :open-pipe :pathname-executable-p
   :set-signal-handler)
  (:prelude :meta* 
   :defverb :*verbs* :verbp :safe-superclasses
   :list-class-methods :list-class-slots
   :slot-values :defclass!
   :defmethods :defaccessor
   :defaccessor* :subclassp)))
