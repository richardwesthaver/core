;;; ironclad.sys
(defsys :ironclad
  :require ("std")
  :version "0.61"
  :components 
  ((:pkg "pkg")
   (:file "condition")
   (:file "generic")
   (:file "util")
   (:mod "opt"
    :components 
    ((:mod "sbcl"
      :components ((:file "fndb")
                   (:file "x86oid-vm")
                   (:file "cpu-features")))))
   (:file "common")
   (:mod "cipher"
    :components ((:file "cipher")
                 (:file "padding")
                 (:file "make-cipher")
                 (:file "modes")
                 (:file "aes")
                 (:file "chacha")
                 (:file "salsa20")))
   (:mod "digest"
    :components ((:file "digest")
                 ;; defaults
                 (:file "crc32")
                 (:file "md5")
                 (:file "blake2")
                 (:file "sha256")
                 (:file "sha3")
                 (:file "sha512")))
   (:mod "mac"
    :components ((:file "mac")
                 (:file "hmac")))
   (:mod "prng"
    :components ((:file "prng")
                 ;; default
                 (:file "os-prng")))
   (:file "math")
   (:file "octet-stream")
   (:mod "aead"
    :components ((:file "aead")))
   (:mod "kdf"
    :components ((:file "kdf")
                 (:file "pkcs5")
                 (:file "password-hash")
                 (:file "argon2")
                 (:file "hmac")))
   (:mod "public-key"
    :components ((:file "public-key")
                 (:file "pkcs1")
                 (:file "elliptic-curve")
                 (:file "curve25519")
                 (:file "ed25519"))))
  :provide
  ((:tests 
    :description "Ironclad Tests"
    :components
    ((:mod "tests"
      :components
      ((:pkg "pkg")))))
   (:proto :cipher
    :functions 
    (make-cipher list-all-ciphers encrypt-in-place decrypt-in-place make-encrypting-stream make-decrypting-stream)
    :predicates (cipher-supported-p)
    :macros (with-encrypting-stream with-decrypting-stream)
    :methods (encrypt decrypt encrypt-message decrypt-message key-lengths block-length))
   (:proto :digest
    :functions (make-digest list-all-digests)
    :methods (update-digest produce-digest digest-sequence digest-file digest-stream digest-length)
    :macros (with-digesting-stream)
    :predicates (digest-supported-p))
   (:proto :kdf
    :functions 
    (make-kdf list-all-kdfs pbkdf2-hash-password pbkdf2-hash-password-to-combined-string pbkdf2-check-password)
    :methods (derive-key))
   (:proto :mac
    :functions (make-mac list-all-macs make-authenticating-stream)
    :macros (with-authenticating-stream)
    :predicates (mac-supported-p)
    :methods (update-mac produce-mac))
   (:proto :prng
    :variables (*prng*)
    :functions (list-all-prngs random-data random-bits strong-random read-os-random-seed write-seed read-seed)
    :methods (make-prng)
   (:proto :aead
    :functions (make-authenticated-encryption-mode list-all-authenticated-encryption-modes)
    :predicates (authenticated-encryption-mode-supported-p)
    :methods (process-associated-data produce-tag))
   (:proto :public-key
    :functions (list-all-key-pair-kinds make-public-key make-private-key make-message)
    :methods 
    (generate-key-pair destructure-public-key destructure-private-key sign-message verify-signature
     make-signature generate-signature-nonce destructure-signature diffie-hellman ec-make-point ec-destructure-point
     ec-point-on-curve ec-point-equal ec-double ec-add ec-scalar-mult ec-scalar-inv ec-encode-scalar ec-decode-scalar
     ec-encode-point ec-decode-point)))))

(macrolet ((define-ironclad-subsystem (aggregate-system path &body components)
             (let ((subsystems (loop for spec in (mapcar #'ensure-list components)
                                     collect (keywordicate (string-upcase 
                                                            (format nil "~a/~a" aggregate-system (first spec)))))))
               `(progn
                  (defsys ,(keywordicate (string-upcase aggregate-system))
                    :require (:ironclad)
                    :provide
                    ,(loop for (component . options) in (mapcar #'ensure-list components)
                           for subsystem in subsystems
                           collect 
                              `(:sys ,(keywordicate (string-upcase subsystem))
                                :description
                                ,(format nil "~a: ~a" aggregate-system component)
                                :require ,(cons :ironclad (getf options :require))
                                :components 
                                ,(or (getf options :components)
                                     `((:file ,(namestring (merge-pathnames component path))))))))))))
  (define-ironclad-subsystem ironclad/cipher #p"cipher/"
    "arcfour"
    "aria"
    "blowfish"
    "camellia"
    "cast5"
    "xsalsa20"
    "xchacha"
    "des"
    "idea"
    "kalyna"
    ("keystream" :require (:ironclad/cipher/chacha
                           :ironclad/cipher/salsa20))
    "kuznyechik"
    "misty1"
    "rc2"
    "rc5"
    "rc6"
    "seed"
    "serpent"
    "sm4"
    "sosemanuk"
    "square"
    "tea"
    "threefish"
    "twofish"
    "xor"
    "xtea")

  (define-ironclad-subsystem
      "ironclad/digest" #p"digest/"
    "adler32"
    "blake2s"
    "crc24"
    "groestl"
    "jh"
    ("kupyna" :require (:ironclad/cipher/kalyna))
    "md2"
    "md4"
    "ripemd-128"
    "ripemd-160"
    "sha1"
    ("skein" :require (:ironclad/cipher/threefish))
    "sm3"
    "streebog"
    "tiger"
    ("tree-hash" :require (:ironclad/digest/tiger))
    "whirlpool")

  (define-ironclad-subsystem
      "ironclad/mac" #p"mac/"
    ("blake2-mac" :require (:ironclad/digest/blake2))
    ("blake2s-mac" :require (:ironclad/digest/blake2s))
    "cmac"
    "gmac"
    "poly1305"
    "siphash"
    ("skein-mac" :require (:ironclad/cipher/threefish
                           :ironclad/digest/skein)))

  (define-ironclad-subsystem
      "ironclad/prng" #p"prng/"
    ("fortuna" :require (:ironclad/cipher/aes
                         :ironclad/digest/sha256)
               :components ((:file "prng/generator")
                            (:file "prng/fortuna"))))

  (define-ironclad-subsystem
      "ironclad/aead" #p"aead/"
    ("eax" :require ("ironclad/mac/cmac"))
    "etm"
    ("gcm" :require ("ironclad/mac/gmac")))

  (define-ironclad-subsystem
      "ironclad/kdf" #p"kdf/"
    ("bcrypt" :require (:ironclad/cipher/blowfish
                        :ironclad/digest/sha512))
    ("scrypt" :require (:ironclad/cipher/salsa20
                        :ironclad/digest/sha256
                        :ironclad/kdf/pkcs5)))

  (define-ironclad-subsystem
      "ironclad/public-key" #p"public-key/"
    "dsa"
    "rsa"
    "elgamal"
    "curve448"
    ("ed448" :require (:ironclad/digest/sha3))
    "secp256k1"
    "secp256r1"
    "secp384r1"
    "secp521r1"))
