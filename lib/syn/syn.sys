;;; core/lib/syn/syn.sys --- Syn Sytem Definitions
(defsys :syn
 :require (:std :obj :parse :tree-sitter :doc :cli :io :dat :cuda)
 :components 
 ((:pkg "pkg")
  (:file "ts")
  (:file "fmt")
  (:mod "gen"
   :components
   ((:file "condition")
    (:file "var")
    (:file "proto")
    (:file "util")
    (:file "read")
    (:mod "c"
     :components 
     ((:file "pkg")
      (:file "read")
      (:file "ast")
      (:file "sym")
      (:file "print")))
    (:mod "cpp"
     :components 
     ((:file "pkg")
      (:file "ast")
      (:file "sym")
      (:file "print")
      (:file "read")))
    (:mod "cu"
     :components 
     ((:file "pkg")
      (:file "ast")
      (:file "print")
      (:file "read")))
    (:mod "py"
     :components ((:file "pkg")))
    (:mod "js"
     :components 
     ((:file "pkg")
      (:file "read")
      (:file "ast")
      (:file "sym")
      (:file "print")
      (:file "macs")))))
  (:file "lint")
  (:file "srv")
  (:mod "lang"
   :components
   ((:file "proto")
    (:file "c")
    (:file "js")
    (:file "py")))
  (:file "tempo")
  (:file "grovel")
  (:file "cli"))
 :provide 
 ((:readtable :tempo)
  (:proto :syn
   :description "Basic syntax.")
  (:proto :lang
   :description "Programming Languages."
   :conditions (lang-condition lang-error lang-warning)
   :classes (lang-config)
   :type (lang)
   :variables (*lang*))
  (:proto :gen
   :description "Code Generator."
   :variables (*gen* *indent* *cl-symbols* *code-reader* *gen-backend-table* *gen-warnings*)
   :macros (defsyntax)
   :types (gen-designator)
   :conditions (gen-condition gen-error simple-gen-error)
   :methods (gen-package gen-reader gen-reader-switch load-gen unload-gen))
  (:proto :tempo
   :description "Lisp Templates."
   :variables (*tempo-case-sensitive* *tempo-package* *tempo-table* *tempo-start* *tempo-end*
               *tempo-variables* *escape-type* *tempo-parameters* *template-tag-expand*)
   :methods (execute-template register-template)
   :functions (make-tempo-function expand-template-tags)
   :macros (deftempo getf-tempo))
  (:proto :grovel)
  (:proto :fmt)
  (:tests 
   :components 
   ((:mod "tests"
     :components 
     ((:file "pkg")
      (:mod "gen"
       :components
       ((:file "pkg")
        (:file "c")
        (:file "cpp")
        (:file "cu")))
      (:mod "lang"
       :components
       ((:file "pkg")
        (:file "c")
        (:file "js")
        (:file "py")))))))))
