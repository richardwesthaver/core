;;; rt.sys --- RT System Definitions

;;; Code:
(defsys :rt
  "RT is a test framework inspired by the SBCL contrib SB-RT.
In addition to regression testing this system includes packages for various
testing and debugging shenanigans."
 :require (:std :log :dat)
 :components 
 ((:pkg "pkg")
  (:file "var")
  (:file "condition")
  (:file "proto")
  (:file "obj")
  (:file "util")
  (:file "cfg")
  (:file "rt")
  (:file "tracing")
  (:file "flamegraph")
  (:file "lipsum")
  (:file "fuzz"))
 :provide
 ((:proto :test)
  (:proto :fuzz)
  (:tests
   :require (:rt)
   :components ((:file "tests")))))
