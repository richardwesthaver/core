;;; rt.sys --- RT System Definitions
(defsys :rt
 :require (:std :log :dat)
 :components ((:file "pkg")
              (:file "var")
              (:file "condition")
              (:file "proto")
              (:file "obj")
              (:file "util")
              (:file "cfg")
              (:file "rt")
              (:file "tracing")
              (:file "flamegraph")
              (:file "fuzz"))
 :provide
 ((:tests
   :require (:rt)
   :components ((:file "tests")))))
