;;; rt.sys --- RT System Definitions
(defsys :rt
 :require (:std :log :dat)
 :components 
 ((:pkg "pkg")
  (:file "var")
  (:file "condition")
  (:file "proto")
  (:file "obj")
  (:file "util")
  (:file "cfg")
  (:file "rt")
  (:file "tracing")
  (:file "flamegraph")
  (:file "fuzz"))
 :provide
 ((:proto :test)
  (:proto :fuzz)
  (:tests
   :require (:rt)
   :components ((:file "tests")))))
