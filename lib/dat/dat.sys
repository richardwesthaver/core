;;; ~/comp/core/lib/dat/dat.sys --- Dat Sytem Definitions
(defsys :dat
 "Data Systems"
 :version "0.1.1"
 :require (:std :log :obj :io :openssl :jpeg)
 :components 
 ((:pkg "pkg" :feature :dat :package :dat-int :export :dat)
  (:file "img")
  (:file "asn1")
  (:file "dot")
  (:file "csv")
  (:file "json")
  (:file "m3u")
  (:file "id3")
  (:file "css")
  (:mod "parquet"
   :components
   ((:file "gen")
    (:file "pkg")
    (:file "obj")
    (:file "thrift")
    (:file "tcompact")
    (:file "io")
    (:file "rle")
    (:file "proto")))
  (:mod "xml"
   :components
   ((:file "xml")
    (:file "stream")
    (:file "svg")))
  (:mod "html"
   :components
   ((:file "const")
    (:file "entity")
    (:file "parse")
    (:file "macs")))
  (:file "yaml")
  (:file "mime")
  (:file "ini")
  (:file "toml")
  (:file "arff")
  (:file "bib")
  (:file "tar")
  (:file "midi")
  (:file "png")
  (:file "jpeg")
  (:file "gif")
  (:file "ttf")
  (:file "base64")
  (:file "qrcode"))
 :provide ((:tests)))


