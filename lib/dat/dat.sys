;;; ~/comp/core/lib/dat/dat.sys --- Dat Sytem Definitions
(defsys :dat
 "Data Systems"
 :version "0.1.1"
 :require (:std :log :obj :io :openssl :jpeg)
 :components 
 ((:pkg "pkg" :feature :dat :internal-package :dat-int :export :dat)
  (:file "img")
  (:file "asn1")
  (:file "dot")
  (:file "csv")
  (:file "json")
  (:file "m3u")
  (:file "id3")
  (:file "css")
  (:mod "parquet"
   :components
   ((:file "gen")
    (:file "pkg")
    (:file "obj")
    (:file "thrift")
    (:file "tcompact")
    (:file "io")
    (:file "rle")
    (:file "proto")))
  (:file "xml")
  (:file "svg")
  (:mod "html"
   :components
   ((:file "const")
    (:file "entity")
    (:file "parse")
    (:file "macs")))
  (:file "yaml")
  (:file "mime")
  (:file "ini")
  (:file "toml")
  (:file "arff")
  (:file "bib")
  (:file "tar")
  (:file "midi")
  (:file "png")
  (:file "jpeg")
  (:file "gif")
  (:file "ttf")
  (:file "base64")
  (:file "qrcode"))
 :provide 
 ((:proto :img)
  (:proto :asn1)
  (:proto :dot)
  (:proto :csv)
  (:proto :json)
  (:proto :m3u)
  (:proto :id3)
  (:proto :css)
  #+todo (:proto :parquet)
  (:proto :xml)
  (:proto :svg)
  (:proto :html)
  #+todo (:proto :yaml)
  (:proto :mime)
  (:proto :ini)
  (:proto :toml)
  (:proto :arff)
  (:proto :bib)
  (:proto :tar)
  (:proto :midi)
  (:proto :png)
  (:proto :jpeg)
  (:proto :gif)
  (:proto :ttf)
  (:proto :base64)
  (:proto :qrcode)
  (:tests)))


