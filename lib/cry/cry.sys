;;; ~/src/core/lib/cry/cry.sys --- Cry Sytem Definitions
(defsys :cry
 :require 
 (:ironclad :math
  :std :log :obj :dat
  :keyutils
  :openssl :io)
 :components 
 ((:pkg "pkg" :feature :cry :internal-package :cry-int :export :cry)
  (:file "condition" :require ("pkg"))
  (:file "crc64" :require ("condition"))
  (:mod "tls"
   :components 
   ((:file "pkg")
    (:file "var")
    (:file "bio")
    (:file "condition")
    (:file "funcall")
    (:file "init")
    (:file "stream")
    (:file "x509")
    (:file "ctx")
    (:file "verify")))
  (:file "password" :require ("condition"))
  (:file "authinfo" :require ("condition"))
  (:file "keyring" :require ("condition"))
  (:file "jwt" :require ("condition"))
  (:file "otp" :require ("condition"))
  (:file "drm" :require ("condition"))
  (:file "gpg" :require ("condition"))
  (:file "ssh" :require ("condition"))
  (:file "auth" :require ("password" "gpg" "jwt" "authinfo" "keyring" "otp")))
 :provide 
 ((:proto :tls)
  (:proto :auth)
  (:proto :crc64)
  (:proto :password)
  (:proto :keyring)
  (:proto :authinfo)
  (:proto :otp)
  (:tests :require (:rt :cry :net))))
