;;; ~/comp/core/lib/cli/cli.sys --- CLI Sytem Definitions
(defsys :cli
 :require (:std :log :dat :obj :io)
 :components 
 ((:pkg "pkg" :internal-package :cli-int :default-package :cli-user :feature :cli)
  (:file "clap")
  (:file "ansi" :require ("pkg"))
  (:file "env" :require ("pkg"))
  (:file "progress" :require ("pkg"))
  (:file "spark" :require ("pkg"))
  (:file "terminfo" :require ("pkg"))
  (:file "ed" :require ("env"))
  (:file "linedit" :require ("pkg" "terminfo" "ed"))
  (:file "shell" :require ("env"))
  (:mod "tools"
   :components
   ((:pkg "pkg" :internal-package :cli-int :feature :tools)
    (:file "proto" :require ("pkg"))
    (:file "term" :require ("proto"))
    (:file "tmux" :require ("term"))
    (:file "pacman" :require ("proto"))
    (:file "cc" :require ("proto"))
    (:file "build" :require ("proto"))
    (:file "virt" :require ("proto"))
    (:file "sys" :require ("proto"))
    (:file "rust" :require ("proto"))
    (:file "sbcl" :require ("proto"))
    (:file "net" :require ("proto"))
    (:file "media" :require ("proto"))
    (:file "mail" :require ("proto"))
    (:file "fs" :require ("proto"))
    (:file "plot" :require ("proto"))))
  (:file "main" :require ("shell" "clap"))
  (:file "tui" :require ("ansi" "progress" "spark" "linedit"))
  (:file "cli" :require ("pkg" "clap")))
 :provide
 ((:proto :editor
   :description "Generic editor.")
  (:proto :repl
   :description "Read Eval Print Loop.")
  (:proto :clap
   :description "Command Line Argument Parser.")
  (:proto :main
   :description "Python-like main function.")
  (:proto :tool
   :description "CLI tool wrappers.")
  (:proto :tui
   :description "Terminal User Interface.")
  (:readtable :shell
   :description "Support for custom Lisp shells.")
  (:tests
   :description "CLI Tests"
   :components
   ((:mod "tests"
     :components
     ((:file "pkg")
      (:file "ansi")))))))

