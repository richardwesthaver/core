;;; core/lib/doc/doc.sys --- Doc Sytem Definitions
(defsys :doc
 "The official documentation system of the core. Contains all modules
necessary for building complete API reference documents."
 :version "0.1.0"
 :require (:std :organ :parse :obj :rdb :log :syn)
 :components 
 ((:pkg "pkg")
  (:file "nlp")
  (:file "fuzzy")
  (:file "proto")
  (:file "reprex")
  (:file "symbol")
  (:file "file")
  (:file "package")
  (:file "system")
  (:file "project")
  (:file "srv"))
 :provide 
 (
  (:proto :nlp)
  (:proto :doc
   :variables (*document-class*)
   :accessors (doc)
   :methods (document-class publish)
   :functions (find-definitions definition-source-line-number classify-symbol symbol-classification-string))
  ;; (:proto :publish)?
  (:proto :reprex)
  (:proto :search)
  (:readtable :doc)
  (:tests :require (:rt :doc :rdb :obj))))
