;;; ~/comp/core/lib/doc/doc.sys --- Doc Sytem Definitions
(defsys :doc
 "The official documentation system of the core. Contains all modules
necessary for building complete API reference documents."
 :version "0.1.0"
 :require (:std :organ :parse :obj :rdb :log)
  :components 
 ((:pkg "pkg")
  (:file "proto")
  (:file "symbol")
  (:file "file")
  (:file "package")
  (:file "asdf")
  (:file "sys")
  (:file "reprex"))
 :provide 
 ((:proto :doc)
  (:readtable :doc)
  (:tests :require (:rt :doc :rdb :obj))))
