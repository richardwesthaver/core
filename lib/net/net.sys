(defsys :net
 :require (:dat :obj :io :parse :rt :cry :std :cli :log)
 :components 
 ((:pkg "pkg" :default-package :net-user :feature :net :internal-package :net-int)
  (:file "obj")
  (:file "address")
  (:file "socket")
  (:mod "codec"
   :components ((:file "dns")
                (:file "tlv")
                (:file "osc")
                (:file "http")
                (:file "dbus")))
  (:mod "proto"
   :components ((:file "dns")
                (:file "swank")
                (:file "crew")
                (:file "http")
                (:file "whois")
                (:file "dict")
                (:file "dbus")
                (:file "ssh")
                (:file "dm")
                (:file "sesh")))
  (:file "cookie")               
  (:file "req")
  (:mod "srv"
   :components 
   ((:file "proto")
    (:file "udp")
    (:file "http")
    (:file "oauth")
    (:file "openapi")
    (:file "ext"))))
 :provide
 ((:proto :net)
  (:proto :http)
  (:proto :dns)
  (:proto :osc)
  (:tests)))

