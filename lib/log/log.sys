;;; log.sys --- logging system
(defsys :log
  :require (:std :io :obj :syslog)
  :components ((:file "pkg")
               (:file "condition")
               (:file "log")
               (:file "db")
               (:file "stream")
               (:file "cfg")
               (:file "sys"))
 :provide
 (:log
  (:asdf "log.asd")
  (:proto log)
  (:tests
   :require (:rt :std :log :io)
   :components ((:file "tests")))))

