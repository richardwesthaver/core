;;; ~/comp/core/lib/obj/obj.sys --- Obj Sytem Definitions
(defsys :obj "Lisp object library"
 :require (:std)
 :components 
 ((:pkg "pkg" :feature :obj :internal-package :obj-int)
  (:mod "meta"
   :components ((:file "sealed")
                (:file "stealth")
                (:file "filtered")
                (:file "fast")
                (:file "lazy")
                (:file "overloaded")
                (:file "stored")
                (:file "dynamic")
                (:file "mix")
                (:file "method")))
  (:file "val")
  (:file "id")
  (:mod "uri"
   :components ((:file "punycode")
                (:file "domain")
                (:file "uri")
                (:file "mask")
                (:file "state")
                (:file "parse")
                (:file "print")
                (:file "path")
                (:file "intern")))
  (:file "url")
  (:mod "tensor"
   :components 
   ((:file "var")
    (:file "condition")
    (:file "meta")
    (:file "base")
    (:file "num")
    (:file "tensor")
    (:file "loop")
    (:file "zeros")
    (:file "ref")
    (:file "print")
    (:file "stride")
    (:file "graph")
    (:file "coord")
    (:file "foreign")
    (:file "copy")
    (:file "perm")
    (:file "einstein")
    (:file "slice")
    (:file "bool")
    (:file "complex")
    (:file "dot")
    (:file "scal")
    (:file "transpose")
    (:file "dfs")
    (:file "rand")
    (:file "map")
    (:file "misc")))
  (:mod "tree"
   :components 
   ((:file "node")
    (:file "btree")))
  (:file "equiv")
  (:mod "color"
   :components ((:file "color")
                (:file "palette")
                (:file "x11")
                (:file "base16")
                (:file "modus")
                (:file "theme")
                (:file "print")))
  (:mod "time"
   :components ((:file "local")
                (:file "util")))
  (:file "uuid")
  (:file "build")
  (:file "ast")
  (:file "config")
  (:file "schema")
  (:file "project")
  (:file "cmd")
  (:file "db")
  (:file "graph")
  (:file "secret")
  (:file "store")
  (:file "cache")
  (:file "srv")
  (:file "obj"))
 :provide
 ((:proto :tensor)
  (:proto :ast)
  (:proto :sxp)
  (:proto :db)
  (:proto :graph)
  (:proto :config)
  (:proto :schema)
  (:proto :project)
  (:proto :cmd)
  (:proto :secret)
  (:proto :store)
  (:proto :cache)
  (:proto :srv)
  (:proto :color)
  (:proto :build)
  (:proto :val)
  (:proto :id)
  (:proto :time)
  (:proto :uri)
  (:proto :url
   :description "URL encoding/decoding."
   :functions (url-encode url-decode url-encode-params url-decode-params rewrite-urls))
  (:proto :node)
  (:proto :tree)
  (:tests
   :components ((:mod "tests" 
                 :components ((:file "pkg")
                              (:file "sealed")
                              (:file "meta")
                              (:file "tensor")))))))
