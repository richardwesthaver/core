(defsystem :obj
  :description "Lisp object library"
  :depends-on (:std)
  :serial t
  :components ((:module "meta"
                :components ((:file "pkg")
                             (:file "sealed")
                             (:file "stealth")
                             (:file "typed")
                             (:file "filtered")
                             (:file "fast")
                             (:file "lazy")
                             (:file "overloaded")
                             (:file "stored")
                             (:file "dynamic")
                             (:file "mix")))
               (:file "pkg")
               (:file "id")
               (:module "uri"
                :components ((:file "punycode")
                             (:file "domain")
                             (:file "uri")
                             (:file "mask")
                             (:file "state")
                             (:file "parse")
                             (:file "print")
                             (:file "path")
                             (:file "intern")))
               (:file "url")
               (:module "tensor"
                :components 
                ((:file "proto")
                 (:file "base")
                 (:file "loop")
                 (:file "print")
                 (:file "copy")
                 (:file "util")
                 (:file "class")
                 (:file "readtable")))
               (:module "tree"
                :components ((:file "node")
                             (:file "avl")
                             (:file "redblack")
                             (:file "brother")
                             (:file "btree")))
               (:file "equiv")
               (:module "color"
                :components ((:file "color")
                             (:file "palette")
                             (:file "x11")
                             (:file "theme")))
               (:module "time"
                :components ((:file "local")
                             (:file "util")))
               (:file "uuid")
               (:file "build")
               (:file "ast")
	       (:file "graph")
               (:file "config")
               (:file "plan")
               (:file "schema")
               (:file "db")
               (:file "secret")
               (:file "store")
               (:file "cache")
               (:file "srv"))
  :in-order-to ((test-op (test-op "obj/tests"))))

(defsystem :obj/tests
  :depends-on (:rt :obj)
  :components ((:file "tests"))
  :perform (test-op (o c) (symbol-call :rt :do-tests :obj)))
