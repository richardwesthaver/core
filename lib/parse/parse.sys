;;; core/lib/parse/parse.sys --- Parse Sytem Definitions
(defsys :parse
 :require (:std)
 :components 
 ((:pkg "pkg" :internal-package :parse-int :export :parse :feature :parse)
  (:file "bytes")
  (:file "lex")
  (:file "pratt")
  (:file "yacc"))
 :provide 
 ((:proto :parse)
  (:proto :lex 
   :functions (make-matcher)
   :macros (with-lexer-environment define-matcher))
  (:proto :bytes
   :macros (with-vector-parsing with-string-parsing with-octets-parsing))
  (:proto :pratt 
   :classes (pratt-parser)
   :methods (parse-prefix parse-infix next-precedence))
  (:proto :yacc
   :macros (define-parser)
   :functions (parse-with-lexer))
  (:tests)))

