;;; core/lib/q/q.sys --- Q Sytem Definitions
(defsys :q
 :require (:std :obj :log :dat :parse)
 :components 
 ((:pkg "pkg" :export :q)
  (:file "query")
  (:file "parser")
  (:file "engine")
  (:file "sql")
  (:file "dql"))
 :provide 
 ((:proto :q)
  (:proto :sql)
  (:proto :dql)
  (:tests :require (:rt :q :log)
   :components
   ((:mod "tests"
     :components ((:file "pkg")
                  (:file "fuzz")
                  (:file "suite")))))))
