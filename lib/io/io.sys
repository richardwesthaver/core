;;; ~/comp/core/lib/io/io.sys --- Io Sytem Definitions
(defsys :io
 "Lisp IO Interface"
 :require (:std
           :ironclad
           :uring
           :xkb
           :evdev
           :btrfs
           ;; :sb-bsd-sockets
           :zstd)
 :version "0.1.0"
 :components ((:pkg "pkg")
              (:file "socket")
              (:file "stream")
              (:file "static")
              (:file "fast")
              (:file "xsubseq")
              (:file "smart-buffer")
              (:file "uring")
              (:file "proto")
              (:file "chunky")
              (:file "flate")
              (:file "zstd")
              (:file "deflate")
              (:mod "disk"
               :components 
               ((:file "pkg")
                (:file "util")
                (:file "proto")
                (:file "btrfs")))
              (:file "kbd")
              (:file "io"))
 :provide
 ((:tests
   :require (:rt :io :uring :sb-bsd-sockets)
   :components ((:file "tests")))
  (:proto :chunky)
  (:proto :fast)
  (:proto :flate)
  (:proto :kbd)
  (:proto :smart-buffer)
  (:proto :static)
  (:proto :disk)))
