;;; ~/comp/core/lib/io/io.sys --- Io Sytem Definitions
(defsys :io
 "Lisp IO Interface"
 :require (:std
           :ironclad/digests
           :ironclad/digest/crc32
           :zstd
           :epoll
           :uring
           :xkb
           :evdev
           :btrfs)
 :version "0.1.0"
 :components 
 ((:pkg "pkg" :feature :io :default :io-user :package :io-int)
  (:file "proto")
  (:file "swap-bytes")
  (:file "socket")
  (:file "stream")
  (:file "static")
  (:file "fast")
  (:file "xsubseq")
  (:file "smart-buffer")
  (:file "uring")
  (:file "chunky")
  (:file "flate")
  (:file "zstd")
  (:file "deflate")
  (:file "lzw")
  (:mod "disk"
   :components 
   ((:file "util")
    (:file "proto")
    (:file "btrfs")))
  (:file "kbd")
  (:file "mux"))
 :provide
 ((:tests
   :require (:rt :io :uring)
   :components ((:file "tests")))
  (:proto :chunky)
  (:proto :fast)
  (:proto :flate)
  (:proto :kbd)
  (:proto :smart-buffer)
  (:proto :xsubseq)
  (:proto :static)
  (:proto :disk)))
