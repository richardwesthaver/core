;;; rust.sk --- core/rust skelfile -*- mode: skel; -*-
:name "core/rust"
:description "CC Rust Core"
:components ((:rust-system "Cargo.toml"
              :components nil))
:rules 
((clean () #$cargo clean$#)
 (update () #$cargo update$#)
 (build () #$cargo build$#)
 (upgrade () #$cargo upgrade$#)
 (fmt () #$cargo fmt$#))
