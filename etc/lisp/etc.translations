;;; etc.translations --- ETC logical pathname translations -*- mode: common-lisp; -*-
(("ACPI;*.*.*" "/etc/acpi/*.*")
 ("ALSA;*.*.*" "/etc/alsa/*.*")
 ("ARCH-RELEASE" "/etc/arch-release")
 ("AUDIT;*.*.*" "/etc/audit/*.*")
 ("BASH" "/etc/bash.bashrc")
 ("BASH;LOGOUT" "/etc/bash.bash_logout")
 ("BASH;COMPLETION;*.*.*" "/etc/bash_completion.d/*.*")
 ("CORE" "/etc/corerc")
 ("DB" "/etc/dbrc")
 ("DB;*.*.*" "/etc/db/*.*")
 ("ENVIRONMENT" "/etc/environment")
 ("FSTAB" "/etc/fstab")
 ("HOSTS" "/etc/hosts")
 ("INPUT" "/etc/inputrc")
 ("KERNEL;*.*.*" "/etc/kernel/*.*")
 ("LD" "/etc/ld.so.conf")
 ("LD;*.*.*" "/etc/ld.so.conf.d/*.*")
 ("LOG" "/etc/logrc")
 ("LOG;*.*.*" "/etc/log/*.*")
 ("VC;*.*.*" "/etc/vc/*.*")
 ("LOGROTATE" "/etc/logrotate.conf")
 ("LOGROTATE;*.*.*" "/etc/logrotate.d/*.*")
 ("LOGIN;DEFS" "/etc/login.defs")
 ("LISP;*.*.*" "/etc/lisp/*.*")
 ("LOCALE" "/etc/locale.conf")
 ("LOCALE;GEN" "/etc/locale.gen")
 ("LOCALTIME" "/etc/localtime")
 ("PACMAN;*.*.*" "/etc/pacman.d/*.*")
 ("PACMAN" "/etc/pacman.conf")
 ("NFS" "/etc/nfs.conf")
 ("NFSMOUNT" "/etc/nfsmount.conf")
 ("PROFILE" "/etc/profile")
 ("PROFILE;*.*.*" "/etc/profile.d/*.*")
 ("REQUEST-KEY" "/etc/request-key.conf")
 ("REQUEST-KEY;*.*.*" "/etc/request-key.d/*.*")
 ("SSL;*.*.*" "/etc/ssl/*.*")
 ("SSH;*.*.*" "/etc/ssh/*.*")
 ("SUDO" "/etc/sudo.conf")
 ("SUDO;LOGSRVD" "/etc/sudo_logsrvd.conf")
 ("SYSTEMD;*.*.*" "/etc/systemd/*.*")
 ("SYSTEMD;SYSTEM;*.*.*" "/etc/systemd/system/*.*")
 ("SYSTEMD;NETWORK;*.*.*" "/etc/systemd/network/*.*")
 ("SYSTEMD;USER;*.*.*" "/etc/systemd/user/*.*")
 ("UDEV;*.*.*" "/etc/udev/*.*")
 ("UDISKS2;*.*.*" "/etc/udisks2/*.*")
 ("UFW;*.*.*" "/etc/ufw/*.*")
 ("UPDATEDB" "/etc/updatedb.conf")
 ("UWSGI;*.*.*" "/etc/uwsgi/*.*")
 ("WEB;*.*.*" "/etc/web/*.*")
 ("WIREGUARD;*.*.*" "/etc/wireguard/*.*")
 ("X11;*.*.*" "/etc/X11/*.*")
 ("XATTR" "/etc/xattr.conf")
 ("XDG;*.*.*" "/etc/xdg/*.*")
 ("MAKEPKG" "/etc/makepkg.conf")
 ("MAKEPKG;*.*.*" "/etc/makepkg.conf.d/*.*"))
 
