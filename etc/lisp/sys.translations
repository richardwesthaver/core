;;; sys.translations --- SYS logical pathname translations -*- mode: common-lisp; -*-
(;; sbcl-defined
 ("SYS:SRC;**;*.*.*" "/usr/src/sbcl/src/**/*.*")
 ("SYS:CONTRIB;**;*.*.*" "/usr/src/sbcl/contrib/**/*.*")
 ("SYS:OUTPUT;**;*.*.*" "/var/tmp/lisp/**/*.*")
 ;; new paths
 ("SITE;**;*.*.*" "/etc/lisp/**/*.*")
 ("CACHE;**;*.*.*" "/var/cache/lisp/**/*.*")
 ("LIB;**;*.*.*" "/var/lib/lisp/**/*.*."))
