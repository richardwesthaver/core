;;; var.translations --- VAR logical pathname translations -*- mode: common-lisp; -*-
(("CACHE;*.*.*" "/var/cache/*.*")
 ("DB;*.*.*" "/var/db/*.*")
 ("EMPTY;*.*.*" "/var/empty/*.*")
 ("GAMES;*.*.*" "/var/games/*.*")
 ("LIB;*.*.*" "/var/lib/*.*")
 ("LOCAL;*.*.*" "/var/local/*.*")
 ("LOCK;*.*.*" "/var/lock/*.*")
 ("LOG;*.*.*" "/var/log/*.*")
 ("MAIL;*.*.*" "/var/mail/*.*")
 ("NAMED;*.*.*" "/var/named/*.*")
 ("OPT;*.*.*" "/var/opt/*.*")
 ("RUN;*.*.*" "/var/run/*.*")
 ("SPOOL;*.*.*" "/var/spool/*.*")
 ("TMP;*.*.*" "/var/tmp/*.*"))