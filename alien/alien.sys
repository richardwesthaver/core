;;; ffi.sys --- Ffi Sytem Definitions
(defsys :alien
 :require
 (:arrow :btrfs :alsa
  :cuda :evdev :glib :gstreamer
  :sndfile :ssh2 :tree-sitter
  :uring :xkb :zstd :jpeg
  :chromaprint :blas :openssl :ffmpeg
  :sys :jack :keyutils :rocksdb
  :security :emacs)
 :provide
 ((:tests
   :components nil
   :require
   (:arrow/tests :btrfs/tests
    :cuda/tests :evdev/tests 
    :keyutils/tests :rocksdb/tests
    :ssh2/tests :tree-sitter/tests :sys/tests :uring/tests 
    :xkb/tests :zstd/tests  :blas/tests :jpeg/tests 
    :openssl/tests :security/tests :emacs/tests :glib/tests
    ;; should be included when MPK is required only
    :jack/tests :chromaprint/tests :alsa/tests :sndfile/tests
    :gstreamer/tests :ffmpeg/tests))))
                 
