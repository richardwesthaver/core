;;; core.sys --- Core System Definitions
(defsys :core
  "The top-level system of the Core project.
Includes Skel and all core library systems. The test system includes all test
modules defined in this project (including alien, ironclad, etc).

Benchmarks and examples are provided in the [[vc:demo][demo]] project and a suite of Core
extensions in the [[vc:shed][shed]]."
  :version "0.1.0"
  :require
  (:std :obj :io :log 
   :dat :rt :parse :cry 
   :cli :net :q :rdb 
   :organ :syn :doc :dsp 
   :math :pod :box :vc 
   :skel)
  :components ((:file "core"))
  :provide 
  ((:tests
    :require
    (:ironclad/* :alien
     :std/tests :log/tests :rt/tests :skel/tests
     :dat/tests :rocksdb/tests :btrfs/tests :uring/tests
     :doc/tests :box/tests
     :syn/tests :organ/tests :obj/tests :math/tests 
     :parse/tests :pod/tests :rt/tests :rdb/tests
     :dsp/tests :cry/tests :io/tests :net/tests 
     :vc/tests :cli/tests :q/tests :blas/tests
     :ironclad/tests :alien/tests))
   (:bin :core :package :core :toplevel "dispatch-core")))
